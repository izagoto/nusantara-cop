# BMKG outbound (respect 60 req/min per IP — keep scheduler conservative)
BMKG_USER_AGENT=IndonesiaCOP/0.1 (+https://github.com/example; disaster-monitoring)
NOWCAST_REFRESH_SECONDS=180
EARTHQUAKE_REFRESH_SECONDS=60

# Optional: cap concurrent CAP fetches when enriching nowcast RSS
NOWCAST_CAP_CONCURRENCY=4

# Weather: on-demand adm4 passthrough (national index + rolling refresh in phase 2)
WEATHER_CACHE_TTL_SECONDS=7200

# Support layers (non-BMKG): NASA FIRMS + USGS
SUPPORT_REFRESH_SECONDS=300
# Daftar di https://firms.modaps.eosdis.nasa.gov/api/map_key/ — kosongkan jika tidak dipakai
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_DAY_RANGE=1

# Grid analitik koroplet (derajat; 0.2 ≈ 622 sel aktif nasional)
GRID_CELL_DEG=0.2

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
